# UEBA Environment Configuration
# Copy this to .env and adjust values

# Database
POSTGRES_USER=ueba_admin
POSTGRES_PASSWORD=ueba_secret_2024
POSTGRES_DB=ueba_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ueba_admin:ueba_secret_2024@postgres:5432/ueba_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=ueba-jwt-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Scoring
ALERT_THRESHOLD=0.65
ML_WEIGHT=0.7
RULE_WEIGHT=0.3

# Simulator
SIMULATOR_API_URL=http://backend:8000
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_USER_COUNT=150
